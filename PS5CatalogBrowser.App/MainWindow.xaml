<Window x:Class="PS5CatalogBrowser.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PS5CatalogBrowser.App" Title="OrbitX" Height="800" Width="1260" MinHeight="620" MinWidth="920" Background="#111827" Foreground="#E5E7EB" FontFamily="Segoe UI">
  <Window.Icon><CroppedBitmap SourceRect="0,450,270,330"><CroppedBitmap.Source><BitmapImage UriSource="Assets/Branding/orbitx-logo.png"/></CroppedBitmap.Source></CroppedBitmap></Window.Icon>
  <Window.Resources>
    <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="SettingsStyles.xaml"/></ResourceDictionary.MergedDictionaries>
    <Style x:Key="OrbitDetails" TargetType="StackPanel">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers><DataTrigger Binding="{Binding DataContext.SelectedEntry.CatalogFormat, RelativeSource={RelativeSource AncestorType=Window}}" Value="Orbit"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
    </Style>
    <local:LaunchVisibilityConverter x:Key="LaunchVisibility"/>
    <local:LibraryCaptionConverter x:Key="LibraryCaption"/>
    <Style x:Key="BrowseTile" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Tile" Background="Transparent" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent" Padding="2"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="#192334"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="#7DD3FC"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="#FBBF24"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SourceRow" TargetType="ListBoxItem" BasedOn="{StaticResource BrowseTile}">
      <Setter Property="Margin" Value="0"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
    </Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E5E7EB"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="Button"><Setter Property="Background" Value="#334155"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#475569"/><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="3"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#0F172A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#475569"/><Setter Property="Padding" Value="7,5"/><Setter Property="Margin" Value="3"/></Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#1E293B"/><Setter Property="Foreground" Value="#F8FAFC"/>
      <Setter Property="BorderBrush" Value="#64748B"/><Setter Property="Margin" Value="3"/>
      <Setter Property="MinWidth" Value="95"/><Setter Property="MinHeight" Value="32"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="DropDownToggle" Focusable="False" Foreground="{TemplateBinding Foreground}" BorderBrush="{TemplateBinding BorderBrush}"
                          Content="{TemplateBinding SelectionBoxItem}"
                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                <Border x:Name="Chrome" Background="#1E293B" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="10,5">
                  <DockPanel LastChildFill="True">
                    <Path DockPanel.Dock="Right" Data="M 0 0 L 4 4 L 8 0" Stroke="#F8FAFC" StrokeThickness="1.6" Margin="12,0,1,0" VerticalAlignment="Center"/>
                    <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
                  </DockPanel>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#334155"/></Trigger>
                  <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#7DD3FC"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate></ToggleButton.Template>
            </ToggleButton>
            <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=DropDownToggle}"
                   IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" StaysOpen="False"
                   Width="{Binding ActualWidth, ElementName=DropDownToggle}">
              <Border Background="#1E293B" BorderBrush="#7DD3FC" BorderThickness="1" MaxHeight="280">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="DropDownToggle" Property="BorderBrush" Value="#7DD3FC"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#F8FAFC"/><Setter Property="Background" Value="#1E293B"/>
      <Setter Property="Padding" Value="9,6"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
          <ContentPresenter/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#334155"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#315A75"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="#1F2937"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#334155"/></Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#CBD5E1"/><Setter Property="Background" Value="#1E293B"/>
      <Setter Property="Padding" Value="16,14"/><Setter Property="MinWidth" Value="92"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="#334155"
                BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
          <ContentPresenter ContentSource="Header" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#334155"/></Trigger>
          <Trigger Property="IsSelected" Value="True">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter TargetName="TabBorder" Property="Background" Value="#315A75"/>
            <Setter TargetName="TabBorder" Property="BorderBrush" Value="#7DD3FC"/>
            <Setter TargetName="TabBorder" Property="BorderThickness" Value="3,0,0,0"/>
          </Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="#FBBF24"/><Setter TargetName="TabBorder" Property="BorderThickness" Value="3,1,1,1"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="#F8FAFC"/><Setter Property="Padding" Value="2"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="ItemBorder" BorderBrush="Transparent" BorderThickness="2" Padding="{TemplateBinding Padding}">
          <ContentPresenter/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#2B3E55"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#7DD3FC"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#FBBF24"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="GroupBox"><Setter Property="Foreground" Value="#93C5FD"/><Setter Property="Margin" Value="8"/><Setter Property="Padding" Value="10"/></Style>
    <Style x:Key="BrowseFilter" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="MinWidth" Value="125"/><Setter Property="Height" Value="36"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton x:Name="Toggle" Foreground="#E4EBF5" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Border x:Name="Pill" Background="#192334" CornerRadius="18" BorderThickness="1" BorderBrush="Transparent" Padding="14,6">
                <DockPanel><Path DockPanel.Dock="Right" Data="M 0 0 L 3 3 L 6 0" Stroke="#BCC9DA" StrokeThickness="1.2" VerticalAlignment="Center" Margin="14,0,0,0"/>
                  <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" VerticalAlignment="Center"/>
                </DockPanel>
              </Border>
              <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Background" Value="#27364C"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <Border x:Name="FocusRing" IsHitTestVisible="False" CornerRadius="18" BorderBrush="Transparent" BorderThickness="2"/>
          <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" StaysOpen="False" Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
            <Border Background="#192334" BorderBrush="#526681" BorderThickness="1" CornerRadius="8" Padding="4" MaxHeight="280"><ScrollViewer><ItemsPresenter/></ScrollViewer></Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="#7DD3FC"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

      </ResourceDictionary>
  </Window.Resources>
  <Grid x:Name="ApplicationLayout" Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="NativeChrome" ClipToBounds="True"><Grid x:Name="NativeToolbar" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><WrapPanel>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Interface" VerticalAlignment="Center" Margin="4"/>
        <ComboBox x:Name="InterfacePicker" ItemsSource="{Binding InterfaceChoices}" SelectedItem="{Binding Interface}" AutomationProperties.Name="Interface" MinWidth="155"/>
        <Button x:Name="ReturnToOrbit" Content="Return to Orbit" Click="ReturnToOrbit_Click" Visibility="Collapsed"/>
        <Button x:Name="OrbitAppearanceButton" Content="Appearance (F2)" Click="OrbitAppearance_Click" ToolTip="Choose Store, Crossbar, Cinema or Panorama"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="WindowsSettingsButton" Content="Windows Settings" Tag="Settings" Click="WindowsPage_Click"/>
        <Button Content="Downloads" Tag="Downloads" Click="WindowsPage_Click"/>
        <Button Content="My Library" Tag="My Library" Click="WindowsPage_Click"/>
        <Button Content="Full screen (F11)" Click="Fullscreen_Click"/>
      </StackPanel>
    </WrapPanel><Button x:Name="CloseAppButton" Grid.Column="1" Content="Close" Click="CloseApp_Click" VerticalAlignment="Top" MinHeight="32" MinWidth="70" Margin="8,3,3,3" ToolTip="Close OrbitX" AutomationProperties.Name="Close OrbitX"/></Grid></Border>
    <ContentControl x:Name="OrbitSurface" Grid.Row="1" Visibility="Collapsed"/>
    <TabControl x:Name="ClassicTabs" Grid.Row="1" TabStripPlacement="Left" Background="#111827" BorderThickness="0">
      <TabItem Header="Browse"><Grid Margin="12" Background="#080D19">
        <Grid.Resources>
          <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb MinHeight="24"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#43536B" CornerRadius="5" Margin="2,0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
              </Track>
            </ControlTemplate></Setter.Value></Setter>
          </Style>
        </Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <WrapPanel Margin="8,8,8,14">
          <StackPanel><TextBlock Text="Search catalogue" Foreground="#BCC9DA" Margin="6,0,0,4" FontSize="11"/><TextBox Width="205" Height="36" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search catalogue" ToolTip="Search title, description or title ID"/></StackPanel>
          <StackPanel><TextBlock Text="Source" Foreground="#BCC9DA" Margin="12,0,0,4" FontSize="11"/><ComboBox Style="{StaticResource BrowseFilter}" ItemsSource="{Binding SourceChoices}" SelectedItem="{Binding SourceFilter}" AutomationProperties.Name="Source filter"/></StackPanel>
          <StackPanel><TextBlock Text="Content type" Foreground="#BCC9DA" Margin="12,0,0,4" FontSize="11"/><ComboBox Style="{StaticResource BrowseFilter}" ItemsSource="{Binding KindChoices}" SelectedItem="{Binding KindFilter}" AutomationProperties.Name="Content type filter"/></StackPanel>
          <StackPanel><TextBlock Text="Platform" Foreground="#BCC9DA" Margin="12,0,0,4" FontSize="11"/><ComboBox Style="{StaticResource BrowseFilter}" ItemsSource="{Binding PlatformChoices}" SelectedItem="{Binding PlatformFilter}" AutomationProperties.Name="Platform filter"/></StackPanel>
          <StackPanel><TextBlock Text="Sort by" Foreground="#BCC9DA" Margin="12,0,0,4" FontSize="11"/><ComboBox Style="{StaticResource BrowseFilter}" ItemsSource="{Binding SortChoices}" SelectedItem="{Binding Sort}" AutomationProperties.Name="Sort catalogue"/></StackPanel>
          <Button Content="Refresh" Click="RefreshAll_Click" VerticalAlignment="Bottom" Height="36" ToolTip="Refresh enabled catalogues"/>
        </WrapPanel>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ListBox x:Name="BrowseList" ItemsSource="{Binding BrowseView}" SelectedItem="{Binding SelectedEntry}" Background="Transparent" BorderThickness="0" Padding="4" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemContainerStyle="{StaticResource BrowseTile}" AutomationProperties.Name="Catalogue titles">
            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemTemplate><DataTemplate><StackPanel Width="160">
              <local:CoverThumbnail Url="{Binding ThumbnailUrl}" FallbackUrl="{Binding CoverFallbackUrl}" Width="160" Height="160" IsHitTestVisible="False"/>
              <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="#E4EBF5" Margin="0,8,0,0"/>
              <TextBlock Foreground="#9DD7F7" FontSize="10" Margin="0,4,0,0"><TextBlock.Text><MultiBinding Converter="{StaticResource LibraryCaption}"><Binding Path="Id"/><Binding Path="DataContext.LibraryView" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></TextBlock.Text></TextBlock>
            </StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <ScrollViewer Grid.Column="1" Width="390" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#111C2C">
            <ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers><DataTrigger Binding="{Binding SelectedEntry}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
            <StackPanel Margin="18" DataContext="{Binding SelectedEntry}">
              <Button Content="Close details" Click="CloseDetails_Click" HorizontalAlignment="Right" Margin="0,0,0,12"/>
              <local:CoverThumbnail Url="{Binding ThumbnailUrl}" FallbackUrl="{Binding CoverFallbackUrl}" Width="170" Height="170" Margin="0,0,0,12"/><TextBlock Text="{Binding Title}" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Margin="0,10,0,10"/><TextBlock Text="{Binding BrowseTitleId, StringFormat=Title ID: {0}}"/><TextBlock Text="{Binding BrowseVersion, StringFormat=Version: {0}}"/><TextBlock Text="{Binding Author, StringFormat=Author: {0}}"/><TextBlock Text="{Binding SourceName, StringFormat=Source: {0}}"/><TextBlock Text="{Binding Platform, StringFormat=Platform: {0}}"/><TextBlock Text="{Binding Kind, StringFormat=Type: {0}}"/><TextBlock Text="{Binding BrowseFormat, StringFormat=Format: {0}}"/><TextBlock Text="{Binding BrowseRegion, StringFormat=Region: {0}}"/><TextBlock Text="{Binding BrowseSizeLabel, StringFormat=Size: {0}}"/><TextBlock Text="{Binding Classification}" Foreground="#FBBF24" Margin="0,8,0,8"/><StackPanel Style="{StaticResource OrbitDetails}"><TextBlock Text="{Binding DataContext.OrbitBrowseSummary, RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap"/><TextBlock Text="{Binding Publisher, StringFormat=Publisher: {0}}"/><TextBlock Text="{Binding Genre, StringFormat=Genre: {0}}"/><TextBlock Text="{Binding Tagline}"/><TextBlock Text="{Binding ReleaseDate, StringFormat=Release date: {0}}"/></StackPanel>
              <TextBlock Text="{Binding DownloadAvailability}" Foreground="#FBBF24"/>
              <TextBlock Text="Files and release options" FontWeight="SemiBold"/>
            <ListBox ItemsSource="{Binding DataContext.MirrorView, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding DataContext.SelectedMirror, RelativeSource={RelativeSource AncestorType=Window}}" Height="280" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#7DD3FC" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" Padding="5,10,35,5"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
              <ListBox.ItemTemplate><DataTemplate><Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"><StackPanel Margin="5,0,35,5">
                <TextBlock Text="{Binding Provider}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Group, StringFormat=Group: {0}}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Format, StringFormat=Format: {0}}"/><TextBlock Text="{Binding ContainerLabel, StringFormat=Container: {0}}"/>
                <TextBlock Text="{Binding ExpectedFileLabel, StringFormat=Expected file: {0}}" TextWrapping="Wrap" ToolTip="{Binding ExpectedFileLabel}"/>
                <TextBlock Text="{Binding SizeLabel}"/>
                <TextBlock Text="{Binding Hostname, StringFormat=Host: {0}}" ToolTip="{Binding Url}" Foreground="#93C5FD"/>
                <TextBlock Text="{Binding Availability}" Foreground="#FBBF24"/>
                <WrapPanel><Button Content="Direct download" Tag="{Binding}" Click="MirrorDirect_Click" IsEnabled="{Binding DirectEnabled}"/><Button Content="Browser-assisted" Tag="{Binding}" Click="MirrorBrowser_Click" IsEnabled="{Binding BrowserEnabled}"/><Button Content="External browser" Tag="{Binding}" Click="MirrorExternal_Click"/><Button Content="Import completed file" Tag="{Binding}" Click="MirrorImport_Click"/></WrapPanel>
              </StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Style="{StaticResource OrbitDetails}" DataContext="{Binding DataContext.SelectedArtifact, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,8">
              <TextBlock Text="Selected release" FontWeight="SemiBold"/><TextBlock Text="{Binding Id, StringFormat=Release ID: {0}}"/>
              <TextBlock Text="{Binding TitleId, StringFormat=Title ID: {0}}"/><TextBlock Text="{Binding Version, StringFormat=Version: {0}}"/>
              <TextBlock Text="{Binding Region, StringFormat=Region: {0}}"/><TextBlock Text="{Binding Provider, StringFormat=Provider: {0}}"/>
              <TextBlock Text="{Binding ProviderSourceId, StringFormat=Provider source: {0}}"/><TextBlock Text="{Binding FileName}"/>
              <TextBlock Text="{Binding Size, StringFormat=Expected bytes: {0:N0}}"/><TextBlock Text="{Binding Format, StringFormat=Content format: {0}}"/>
              <TextBlock Text="{Binding Compression, StringFormat=Archive compression: {0}}"/><TextBlock Text="{Binding ExtractedSizeLabel, StringFormat=Extracted size: {0}}"/>
              <TextBlock Text="{Binding ArchiveContents, StringFormat=Archive contents: {0}}"/><TextBlock Text="{Binding Notes}"/>
              <TextBlock Text="{Binding Url, StringFormat=Catalogue URL: {0}}"/><TextBlock Text="{Binding BrowserUrl, StringFormat=Browser URL: {0}}"/>
              <TextBlock Text="{Binding SourceVerification, StringFormat=Source verification: {0}}"/>
            </StackPanel>
            <Button Content="Download all files (PS5 Library)" Click="DownloadAll_Click" IsEnabled="{Binding DownloadAllEnabled}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding CatalogFormat}" Value="OptiStore"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
            <TextBlock Text="Select one source for each file. Browser downloads require confirmation and local inspection before a launch attempt." FontSize="12" Foreground="#CBD5E1"/>
</StackPanel></ScrollViewer>
        </Grid></Grid></TabItem>
      <TabItem Header="Downloads"><Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ListBox x:Name="DownloadList" ItemsSource="{Binding DownloadView}" SelectedItem="{Binding SelectedJob}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Downloads">
          <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="8">
            <local:CoverThumbnail Url="{Binding CoverUrl}" FallbackUrl="{Binding CoverFallbackUrl}" Width="72" Height="72" Margin="0,0,14,0" VerticalAlignment="Top"/>
            <StackPanel><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding FileName}" Foreground="#CBD5E1"/>
              <TextBlock Text="{Binding State}" Foreground="#FBBF24"/>
              <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding DownloadedSizeLabel}"/><TextBlock Text=" / "/><TextBlock Text="{Binding TotalSizeLabel}"/><TextBlock Text="{Binding Percentage, StringFormat={}  ({0:F1}%)}"/></StackPanel>
              <TextBlock Text="{Binding Error}" Foreground="#FCA5A5"/>
              <TextBlock Text="{Binding ArchiveStatus}" Foreground="#FBBF24" FontWeight="SemiBold"/>
            </StackPanel>
          </DockPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
          <ItemsControl ItemsSource="{Binding BrowserDownloads.Sessions}"><ItemsControl.ItemTemplate><DataTemplate>
            <WrapPanel><TextBlock Text="{Binding Title}" VerticalAlignment="Center" Margin="4"/><Button Content="Check status" Tag="{Binding Id}" Click="CheckDownloadStatus_Click"/></WrapPanel>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <TextBlock Text="{Binding DownloadExplanation}" Margin="4,0,4,8" AutomationProperties.LiveSetting="Polite"/>
          <TextBlock Text="{Binding SelectedDownloadInstallationStatus}" Background="#263F50" Foreground="#BAE6FD" Padding="6" Margin="4,0,4,8" HorizontalAlignment="Left" AutomationProperties.LiveSetting="Polite">
            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding SelectedDownloadInstallationStatus}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding ExtractionFeedback}" Foreground="#93C5FD" Margin="4,0,4,8" AutomationProperties.LiveSetting="Polite"/>
          <ProgressBar Value="{Binding ExtractionPercentage, Mode=OneWay}" Maximum="100" Height="8" Margin="4,0,4,8" AutomationProperties.Name="Archive extraction progress">
            <ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsExtracting}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style>
          </ProgressBar>
          <WrapPanel>
            <Button x:Name="DownloadActionButton" Content="{Binding DownloadActionLabel}" Click="DownloadAction_Click" IsEnabled="{Binding CanRunDownloadAction}" MinWidth="145" Background="#315B73">
              <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ShowDownloadAction}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
            </Button>
            <Button Content="Open downloads folder" Click="OpenDownloadsFolder_Click"/>
            <Button Content="{Binding ScanDownloadsLabel}" Click="ScanDownloads_Click" IsEnabled="{Binding CanScanDownloads}"/>
            <Button Content="Delete failed download" Click="DeleteDownload_Click" IsEnabled="{Binding CanDeleteSelectedDownload}"/>
          </WrapPanel>
          <Expander Header="More actions" Margin="4,8,4,0" Foreground="#E5E7EB">
            <StackPanel><TextBlock Text="{Binding SelectedJob.Source, StringFormat=Source: {0}}" Margin="4,8,4,0"/>
              <TextBlock Text="{Binding SelectedJob.Destination, StringFormat=File: {0}}" Margin="4,0"/>
              <TextBlock Text="{Binding SelectedJob.BytesPerSecond, StringFormat=Transfer speed: {0:N0} B/s}" Margin="4,0"/>
            <WrapPanel Margin="0,8,0,0">
              <Button Content="Pause" Click="Pause_Click" IsEnabled="{Binding SelectedJob.CanPause}"/>
              <Button Content="Retry" Click="RetryFailed_Click" IsEnabled="{Binding CanRetrySelectedDownload}"/><Button Content="Resume" Click="Resume_Click" IsEnabled="{Binding SelectedJob.CanResume}"/>
              <Button Content="Cancel download" Click="Cancel_Click"/><Button Content="Restart download" Click="Retry_Click"/>
              <Button Content="Clear selected history" Click="ClearSelectedHistory_Click"/>
              <Button Content="Clear completed history" Click="ClearDownloads_Click" ToolTip="Keep files and library entries; clear completed history only."/>
              <Button Content="Discard incomplete download…" Click="DiscardDownload_Click"/>
            </WrapPanel></StackPanel>
          </Expander>
        </StackPanel>
      </Grid></TabItem>
