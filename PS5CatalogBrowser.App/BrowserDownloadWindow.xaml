<Window x:Class="PS5CatalogBrowser.App.BrowserDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Browser-assisted download" ShowInTaskbar="False" Width="1050" Height="760" MinWidth="700" MinHeight="500"
        Background="#111827" Foreground="#F1F5F9" FontFamily="Segoe UI">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="12,7"/><Setter Property="Background" Value="#E2E8F0"/><Setter Property="Foreground" Value="#111827"/></Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  </Window.Resources>
  <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock x:Name="SelectionLabel" FontSize="17" FontWeight="SemiBold" Margin="4"/>
      <TextBlock x:Name="WorkflowGuidance" x:FieldModifier="internal" Text="Opening this provider webpage does not create a download. Confirm a file offered by WebView2 to start a tracked transfer. Before that, close this window to leave the page. Complete any provider verification. If repeated Download clicks only open popups, stop retrying and use the external browser. If no file is offered or the page cannot load, use the external browser and import the matching completed file. External transfers must be cancelled in that browser." Margin="4" Foreground="#CBD5E1"/>
      <WrapPanel>
        <Button Content="Back" Click="Back_Click"/><Button Content="Reload" Click="Reload_Click"/>
        <Button Content="Open in external browser" Click="External_Click"/>
        <Button Content="Import completed external download" Click="Import_Click"/>
        <Button x:Name="ChooseAnother" Content="Choose another download" Click="ChooseAnother_Click" Visibility="Collapsed"/>
      </WrapPanel>
      <WrapPanel>
        <CheckBox x:Name="EnableDiagnostics" Content="Record sanitised diagnostics (this window only)" Foreground="#F1F5F9" Margin="4" Checked="Diagnostics_Changed" Unchecked="Diagnostics_Changed"/>
        <Button Content="Export diagnostics" Click="ExportDiagnostics_Click"/>
      </WrapPanel>
      <CheckBox x:Name="BlockPopups" x:FieldModifier="internal" Content="Block popup windows" IsChecked="True" Foreground="#F1F5F9" Margin="4"/><TextBlock x:Name="PopupStatus" x:FieldModifier="internal" Margin="4" Foreground="#CBD5E1"/><TextBlock x:Name="PageStatus" Margin="4,4,4,10" Foreground="#7DD3FC"/>
    </StackPanel>
    <wv:WebView2 x:Name="Browser" x:FieldModifier="public"/>
  </DockPanel>
</Window>
