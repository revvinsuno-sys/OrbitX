<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <LinearGradientBrush x:Key="SettingsPanelBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F009233A"/><GradientStop Color="#E5081A2D" Offset="0.5"/><GradientStop Color="#F005111E" Offset="1"/></LinearGradientBrush>
  <Style x:Key="SettingsButton" TargetType="Button">
    <Setter Property="Foreground" Value="#F5F8FF"/><Setter Property="Background" Value="#CC193149"/><Setter Property="BorderBrush" Value="#496987"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,8"/><Setter Property="Margin" Value="0,4,10,4"/><Setter Property="MinHeight" Value="42"/><Setter Property="FontSize" Value="15"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{DynamicResource SettingsActionIcon}" Width="18" Height="18" Margin="0,0,10,0" IsHitTestVisible="False"><Image.Style><Style TargetType="Image"><Style.Triggers><Trigger Property="Source" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></Image.Style></Image><ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/></StackPanel></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#DA164F77"/><Setter TargetName="Chrome" Property="BorderBrush" Value="#00BFFF"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#075583"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#FFE39B"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.5"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsPrimaryButton" TargetType="Button" BasedOn="{StaticResource SettingsButton}"><Setter Property="BorderBrush" Value="#00BBFF"/><Setter Property="Background" Value="#B500467C"/></Style>
  <Style x:Key="SettingsNavigationButton" TargetType="Button" BasedOn="{StaticResource SettingsButton}">
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="8,6"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="#AFD6FF"/>
  </Style>
  <Style x:Key="SettingsSection" TargetType="GroupBox">
    <Setter Property="Foreground" Value="#F5F8FF"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="Padding" Value="18,12"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupBox">
      <Border Background="{StaticResource SettingsPanelBrush}" BorderBrush="#316083" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
        <StackPanel><ContentPresenter ContentSource="Header" TextElement.FontSize="22" TextElement.FontWeight="Normal" Margin="0,0,0,8"/><ContentPresenter/></StackPanel>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsStatusBadge" TargetType="Border">
    <Setter Property="Background" Value="#B00C3045"/><Setter Property="BorderBrush" Value="#426C88"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/>
    <Setter Property="Padding" Value="9,4"/><Setter Property="Margin" Value="0,2,10,4"/><Setter Property="MaxWidth" Value="640"/><Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>
  <Style x:Key="SettingsTile" TargetType="Button" BasedOn="{StaticResource SettingsButton}">
    <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,10,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Tile" Background="#091A2C" BorderBrush="#37516C" BorderThickness="1" CornerRadius="2" ClipToBounds="True">
        <ContentPresenter/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="#72D7FF"/></Trigger>
        <Trigger Property="Tag" Value="Selected"><Setter TargetName="Tile" Property="BorderBrush" Value="#00BFFF"/><Setter TargetName="Tile" Property="BorderThickness" Value="2"/><Setter TargetName="Tile" Property="Effect"><Setter.Value><DropShadowEffect Color="#009FFF" ShadowDepth="0" BlurRadius="13" Opacity="0.55"/></Setter.Value></Setter></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="#FFE39B"/><Setter TargetName="Tile" Property="BorderThickness" Value="2"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsTextBox" TargetType="TextBox">
    <Setter Property="Foreground" Value="#F5F8FF"/><Setter Property="Background" Value="#B3041020"/><Setter Property="BorderBrush" Value="#496987"/><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,4,0,10"/><Setter Property="MinHeight" Value="38"/>
    <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#FFE39B"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="SettingsExpander" TargetType="Expander"><Setter Property="Foreground" Value="#F5F8FF"/><Setter Property="Margin" Value="0,12,0,0"/><Setter Property="Padding" Value="10"/><Setter Property="Background" Value="#80061220"/><Setter Property="BorderBrush" Value="#37516C"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style x:Key="SettingsScrollBar" TargetType="ScrollBar">
    <Setter Property="Width" Value="10"/><Setter Property="Background" Value="#8007111E"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
      <Border Background="{TemplateBinding Background}"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
        <Track.DecreaseRepeatButton><RepeatButton x:Name="Decrease" Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
        <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" Background="#527797" CornerRadius="4" Margin="2"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#85C9F5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        <Track.IncreaseRepeatButton><RepeatButton x:Name="Increase" Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
      </Track></Border>
      <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="Decrease" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="Increase" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Height" Value="10"/><Setter Property="Width" Value="Auto"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="SettingsToggle" TargetType="CheckBox">
    <Setter Property="Foreground" Value="#F5F8FF"/><Setter Property="Margin" Value="0,8"/><Setter Property="MinHeight" Value="32"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
      <DockPanel Background="Transparent">
        <Border x:Name="Track" DockPanel.Dock="Left" Width="42" Height="23" CornerRadius="12" Background="#52657B" BorderBrush="#91A4BA" BorderThickness="1" Margin="0,0,12,0">
          <Ellipse x:Name="Thumb" Width="17" Height="17" Fill="White" HorizontalAlignment="Left" Margin="2"/>
        </Border><ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </DockPanel>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#008DCD"/><Setter TargetName="Track" Property="BorderBrush" Value="#00C4FF"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#FFE39B"/><Setter TargetName="Track" Property="BorderThickness" Value="2"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
