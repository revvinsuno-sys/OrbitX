diff --git a/tests/EmulatorMenuTests.cpp b/tests/EmulatorMenuTests.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..bc7e254f0003901983898b91df409cc0319f502e
--- /dev/null
+++ b/tests/EmulatorMenuTests.cpp
@@ -0,0 +1,105 @@
+#include "graphics/presentation/emulatorMenu.h"
+
+#include <cstdio>
+#include <cstdlib>
+
+using namespace Libs::Graphics;
+
+static void Check(bool condition, const char* message) {
+	if (!condition) {
+		std::fprintf(stderr, "FAIL emulator menu: %s\n", message);
+		std::exit(1);
+	}
+}
+
+static SDL_Event Button(Uint8 button, bool down = true) {
+	SDL_Event event {};
+	event.type           = down ? SDL_EVENT_GAMEPAD_BUTTON_DOWN : SDL_EVENT_GAMEPAD_BUTTON_UP;
+	event.gbutton.button = button;
+	event.gbutton.down   = down;
+	return event;
+}
+
+static SDL_Event Key(SDL_Keycode key, bool repeat = false) {
+	SDL_Event event {};
+	event.type       = SDL_EVENT_KEY_DOWN;
+	event.key.key    = key;
+	event.key.down   = true;
+	event.key.repeat = repeat;
+	return event;
+}
+
+int main() {
+	EmulatorMenu menu;
+	Check(menu.Handle(Button(SDL_GAMEPAD_BUTTON_SOUTH)) == EmulatorMenuResult::Ignored,
+	      "normal gameplay must pass through while closed");
+	menu.Handle(Button(SDL_GAMEPAD_BUTTON_GUIDE));
+	Check(menu.Read().visible && !menu.Read().exit_selected,
+	      "Guide must open with Continue selected");
+	menu.Handle(Button(SDL_GAMEPAD_BUTTON_GUIDE, false));
+	Check(menu.Read().visible, "Guide release must not toggle or exit");
+	Check(menu.Handle(Button(SDL_GAMEPAD_BUTTON_SOUTH)) == EmulatorMenuResult::Consumed &&
+	          !menu.Read().visible,
+	      "default confirmation must continue, never exit");
+	menu.Handle(Button(SDL_GAMEPAD_BUTTON_GUIDE));
+	menu.Handle(Button(SDL_GAMEPAD_BUTTON_DPAD_DOWN));
+	Check(menu.Read().exit_selected, "D-pad down must select Exit");
+	Check(menu.Handle(Button(SDL_GAMEPAD_BUTTON_EAST)) == EmulatorMenuResult::Consumed &&
+	          !menu.Read().visible,
+	      "cancel must dismiss even when Exit is selected");
+	menu.Handle(Button(SDL_GAMEPAD_BUTTON_GUIDE));
+	Check(!menu.Read().exit_selected, "reopening must forget an earlier Exit selection");
+	menu.Handle(Button(SDL_GAMEPAD_BUTTON_DPAD_DOWN));
+	Check(menu.Handle(Button(SDL_GAMEPAD_BUTTON_SOUTH)) == EmulatorMenuResult::Quit &&
+	          !menu.Read().visible,
+	      "Exit must request the normal quit path after explicit selection");
+	menu.Handle(Key(SDLK_F10));
+	const auto revision = menu.Read().revision;
+	menu.Handle(Key(SDLK_F10, true));
+	Check(menu.Read().visible && menu.Read().revision == revision,
+	      "held F10 must not flicker the menu");
+	menu.Handle(Key(SDLK_DOWN));
+	Check(menu.Handle(Key(SDLK_RETURN, true)) == EmulatorMenuResult::Consumed &&
+	          menu.Read().visible,
+	      "a held Enter key must not confirm Exit");
+	Check(menu.Handle(Key(SDLK_ESCAPE)) == EmulatorMenuResult::Consumed && !menu.Read().visible,
+	      "keyboard cancel must always continue");
+	menu.Handle(Key(SDLK_F10));
+	SDL_Event event {};
+	for (const Uint32 type:
+	     {SDL_EVENT_GAMEPAD_AXIS_MOTION, SDL_EVENT_GAMEPAD_TOUCHPAD_DOWN,
+	      SDL_EVENT_GAMEPAD_SENSOR_UPDATE, SDL_EVENT_MOUSE_WHEEL, SDL_EVENT_TEXT_INPUT}) {
+		event      = {};
+		event.type = type;
+		Check(menu.Handle(event) == EmulatorMenuResult::Consumed,
+		      "menu input must not reach the game");
+	}
+	for (const Uint32 type: {SDL_EVENT_QUIT, SDL_EVENT_WINDOW_FOCUS_LOST, SDL_EVENT_GAMEPAD_ADDED,
+	                         SDL_EVENT_GAMEPAD_REMOVED}) {
+		event      = {};
+		event.type = type;
+		Check(menu.Handle(event) == EmulatorMenuResult::Ignored,
+		      "window and device lifecycle events must pass through");
+	}
+	event             = {};
+	event.type        = SDL_EVENT_GAMEPAD_AXIS_MOTION;
+	event.gaxis.axis  = SDL_GAMEPAD_AXIS_LEFTY;
+	event.gaxis.value = 24000;
+	menu.Handle(event);
+	Check(menu.Read().exit_selected, "left stick down must select Exit");
+	event.gaxis.value = -24000;
+	menu.Handle(event);
+	Check(!menu.Read().exit_selected, "left stick up must select Continue");
+	for (const float scale: {0.5f, 1.0f, 2.0f}) {
+		event               = {};
+		event.type          = SDL_EVENT_MOUSE_BUTTON_DOWN;
+		event.button.button = SDL_BUTTON_LEFT;
+		event.button.x      = 640.0f * scale;
+		event.button.y      = 420.0f * scale;
+		Check(menu.Handle(event, 1280.0f * scale, 720.0f * scale) == EmulatorMenuResult::Quit,
+		      "mouse hit testing must match the rendered Exit row at every DPI");
+		menu.Handle(Key(SDLK_F10));
+	}
+	std::puts("PASS emulator menu controller, keyboard, capture, lifecycle, and "
+	          "pointer tests");
+}
