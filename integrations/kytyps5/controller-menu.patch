diff --git a/src/graphics/presentation/emulatorMenu.h b/src/graphics/presentation/emulatorMenu.h
new file mode 100644
index 0000000000000000000000000000000000000000..8c8d9a5467c263843df73a7d6a2bab52739a1061
--- /dev/null
+++ b/src/graphics/presentation/emulatorMenu.h
@@ -0,0 +1,147 @@
+#ifndef KYTY_GRAPHICS_PRESENTATION_EMULATOR_MENU_H_
+#define KYTY_GRAPHICS_PRESENTATION_EMULATOR_MENU_H_
+
+#include <SDL3/SDL.h>
+#include <algorithm>
+#include <cstdint>
+#include <mutex>
+
+namespace Libs::Graphics {
+
+enum class EmulatorMenuResult { Ignored, Consumed, Quit };
+
+struct EmulatorMenuLayout {
+	float scale;
+	float left;
+	float top;
+	float width;
+	float height;
+
+	static EmulatorMenuLayout ForSize(float width, float height) {
+		const float scale = std::min(width / 1280.0f, height / 720.0f);
+		return {scale, (width - 640.0f * scale) * 0.5f, (height - 360.0f * scale) * 0.5f,
+		        640.0f * scale, 360.0f * scale};
+	}
+
+	int RowAt(float x, float y) const {
+		if (x < left + 24.0f * scale || x > left + width - 24.0f * scale) {
+			return -1;
+		}
+		for (int row = 0; row < 2; ++row) {
+			const float row_top = top + (140.0f + row * 72.0f) * scale;
+			if (y >= row_top && y <= row_top + 60.0f * scale) {
+				return row;
+			}
+		}
+		return -1;
+	}
+};
+
+class EmulatorMenu final {
+public:
+	struct Snapshot {
+		bool     visible;
+		bool     exit_selected;
+		uint64_t revision;
+	};
+
+	Snapshot Read() const {
+		std::scoped_lock lock(m_mutex);
+		return m_state;
+	}
+
+	EmulatorMenuResult Handle(const SDL_Event& event, float width = 1280, float height = 720) {
+		const auto state = Read();
+		const bool guide = (event.type == SDL_EVENT_GAMEPAD_BUTTON_DOWN ||
+		                    event.type == SDL_EVENT_GAMEPAD_BUTTON_UP) &&
+		                   event.gbutton.button == SDL_GAMEPAD_BUTTON_GUIDE;
+		const bool toggle_key =
+		    (event.type == SDL_EVENT_KEY_DOWN || event.type == SDL_EVENT_KEY_UP) &&
+		    event.key.key == SDLK_F10;
+		if (guide || toggle_key) {
+			if ((guide && event.gbutton.down) ||
+			    (toggle_key && event.key.down && !event.key.repeat)) {
+				Set(!state.visible, false);
+			}
+			return EmulatorMenuResult::Consumed;
+		}
+		if (!state.visible) {
+			return EmulatorMenuResult::Ignored;
+		}
+		switch (event.type) {
+			case SDL_EVENT_KEY_DOWN:
+				if (!event.key.repeat) {
+					switch (event.key.key) {
+						case SDLK_ESCAPE: Set(false, false); break;
+						case SDLK_UP: Set(true, false); break;
+						case SDLK_DOWN: Set(true, true); break;
+						case SDLK_RETURN:
+						case SDLK_KP_ENTER: return Confirm(state.exit_selected);
+						default: break;
+					}
+				}
+				return EmulatorMenuResult::Consumed;
+			case SDL_EVENT_GAMEPAD_BUTTON_DOWN:
+				switch (event.gbutton.button) {
+					case SDL_GAMEPAD_BUTTON_EAST: Set(false, false); break;
+					case SDL_GAMEPAD_BUTTON_DPAD_UP: Set(true, false); break;
+					case SDL_GAMEPAD_BUTTON_DPAD_DOWN: Set(true, true); break;
+					case SDL_GAMEPAD_BUTTON_SOUTH: return Confirm(state.exit_selected);
+					default: break;
+				}
+				return EmulatorMenuResult::Consumed;
+			case SDL_EVENT_GAMEPAD_AXIS_MOTION:
+				if (event.gaxis.axis == SDL_GAMEPAD_AXIS_LEFTY &&
+				    (event.gaxis.value < -16000 || event.gaxis.value > 16000)) {
+					Set(true, event.gaxis.value > 0);
+				}
+				return EmulatorMenuResult::Consumed;
+			case SDL_EVENT_MOUSE_BUTTON_DOWN:
+				if (event.button.button == SDL_BUTTON_LEFT) {
+					const int row = EmulatorMenuLayout::ForSize(width, height)
+					                    .RowAt(event.button.x, event.button.y);
+					if (row >= 0) {
+						return Confirm(row == 1);
+					}
+				}
+				return EmulatorMenuResult::Consumed;
+			case SDL_EVENT_KEY_UP:
+			case SDL_EVENT_TEXT_INPUT:
+			case SDL_EVENT_TEXT_EDITING:
+			case SDL_EVENT_MOUSE_BUTTON_UP:
+			case SDL_EVENT_MOUSE_MOTION:
+			case SDL_EVENT_MOUSE_WHEEL:
+			case SDL_EVENT_FINGER_DOWN:
+			case SDL_EVENT_FINGER_UP:
+			case SDL_EVENT_FINGER_MOTION:
+			case SDL_EVENT_GAMEPAD_BUTTON_UP:
+			case SDL_EVENT_GAMEPAD_TOUCHPAD_DOWN:
+			case SDL_EVENT_GAMEPAD_TOUCHPAD_UP:
+			case SDL_EVENT_GAMEPAD_TOUCHPAD_MOTION:
+			case SDL_EVENT_GAMEPAD_SENSOR_UPDATE: return EmulatorMenuResult::Consumed;
+			default: return EmulatorMenuResult::Ignored;
+		}
+	}
+
+private:
+	void Set(bool visible, bool exit_selected) {
+		std::scoped_lock lock(m_mutex);
+		if (m_state.visible != visible || m_state.exit_selected != exit_selected) {
+			m_state.visible = visible;
+			m_state.exit_selected = exit_selected;
+			m_state.revision++;
+		}
+	}
+
+	EmulatorMenuResult Confirm(bool exit_selected) {
+		Set(false, false);
+		return exit_selected ? EmulatorMenuResult::Quit : EmulatorMenuResult::Consumed;
+	}
+
+	mutable std::mutex m_mutex;
+	Snapshot m_state {false, false, 0};
+};
+
+} // namespace Libs::Graphics
+
+#endif
