+// Local OrbitX integration; GPL-2.0-or-later, like SharpEmu.
+using SDL;
+using SharpEmu.HLE.Host;
+using SharpEmu.Libs.Pad;
+
+namespace SharpEmu.Libs.VideoOut;
+
+internal static class BrowserGameMenu
+{
+    private static long revision;
+    internal static long Revision => Interlocked.Read(ref revision);
+    private static void Select(int value) { if (Interlocked.Exchange(ref state, value) != value) Interlocked.Increment(ref revision); }
+    private static int state; // 0 closed, 1 Continue, 2 Exit to library
+    private static HostGamepadButtons previousButtons;
+    private static int previousStick;
+    internal static bool Visible => Volatile.Read(ref state) != 0;
+    internal static bool ExitSelected => Volatile.Read(ref state) == 2;
+
+    internal static void Close()
+    {
+        if (Visible) { Select(0); HostWindowInput.SetMenuCaptured(false); }
+    }
+
+    private static void Toggle()
+    {
+        if (Visible) Close();
+        else
+        {
+            HostWindowInput.SetMenuCaptured(true);
+            Select(1);
+        }
+    }
+
+    // Returns whether this keyboard event belongs to the menu, including repeat/key-up.
+    internal static bool Key(SDL_Keycode key, bool down, bool repeat, out bool exit)
+    {
+        exit = false;
+        if (key == SDL_Keycode.SDLK_F10)
+        {
+            if (down && !repeat) Toggle();
+            return true;
+        }
+        if (!Visible) return false;
+        if (!down || repeat) return true;
+        if (key == SDL_Keycode.SDLK_ESCAPE) Close();
+        else if (key is SDL_Keycode.SDLK_UP or SDL_Keycode.SDLK_LEFT) Select(1);
+        else if (key is SDL_Keycode.SDLK_DOWN or SDL_Keycode.SDLK_RIGHT) Select(2);
+        else if (key == SDL_Keycode.SDLK_RETURN)
+        {
+            exit = ExitSelected;
+            Close();
+        }
+        return true;
+    }
+
+    internal static bool Gamepad(HostGamepadState pad)
+    {
+        var buttons = pad.Buttons;
+        var pressed = buttons & ~previousButtons;
+        var stick = pad.LeftY < 70 ? -1 : pad.LeftY > 186 ? 1 : 0;
+        var direction = stick != previousStick ? stick : 0;
+        previousButtons = buttons;
+        previousStick = stick;
+        if ((pressed & HostGamepadButtons.Ps) != 0) { Toggle(); return false; }
+        if (!Visible) return false;
+        if ((pressed & HostGamepadButtons.Circle) != 0) { Close(); return false; }
+        if ((pressed & HostGamepadButtons.Up) != 0 || direction == -1) Select(1);
+        if ((pressed & HostGamepadButtons.Down) != 0 || direction == 1) Select(2);
+        if ((pressed & HostGamepadButtons.Cross) == 0) return false;
+        var exit = ExitSelected;
+        Close();
+        return exit;
+    }
+
+    internal static OverlayRectangle Rectangle(int width, int height)
+    {
+        var w = Math.Min(Math.Max(0, width), PerfOverlay.PanelWidth);
+        var h = Math.Min(Math.Max(0, height), PerfOverlay.PanelHeight);
+        return new((width - w) / 2, (height - h) / 2, w, h);
+    }
+
+    internal static bool Pointer(float x, float y, int width, int height)
+    {
+        var rect = Rectangle(width, height);
+        if (rect.Width == 0 || rect.Height == 0) return false;
+        x -= rect.Left;
+        y -= rect.Top;
+        if (x < 8 || x >= PerfOverlay.PanelWidth - 8) return false;
+        if (y >= 44 && y < 68) { Close(); return false; }
+        if (y >= 78 && y < 102) { Close(); return true; }
+        return false;
+    }
+}
