+// Local OrbitX integration; GPL-2.0-or-later.
+using SharpEmu.Libs.Gpu.Vulkan;
+using Silk.NET.Vulkan;
+namespace SharpEmu.Libs.VideoOut;
+
+internal static unsafe partial class VulkanVideoPresenter
+{
+    private sealed partial class Presenter
+    {
+        private Image _browserBackground;
+        private DeviceMemory _browserBackgroundMemory;
+        private bool _browserBackgroundValid, _browserBackgroundHdr;
+        private long _browserPresentedRevision;
+
+        private void DestroyBrowserBackground()
+        {
+            // Called with all frame slots drained, together with swapchain destruction.
+            if (_browserBackground.Handle != 0) _vk.DestroyImage(_device, _browserBackground, null);
+            if (_browserBackgroundMemory.Handle != 0) _deviceInfo.FreeMemory(_browserBackgroundMemory);
+            _browserBackground = default;
+            _browserBackgroundMemory = default;
+            _browserBackgroundValid = false;
+            _browserPresentedRevision = -1;
+        }
+
+        private void RecordBrowserBackground(uint index, bool restore)
+        {
+            if (_browserBackground.Handle == 0)
+            {
+                var info = new ImageCreateInfo
+                {
+                    SType = StructureType.ImageCreateInfo, ImageType = ImageType.Type2D,
+                    Format = PresentationTargetFormat, Extent = new(_extent.Width, _extent.Height, 1),
+                    MipLevels = 1, ArrayLayers = 1, Samples = SampleCountFlags.Count1Bit,
+                    Tiling = ImageTiling.Optimal, SharingMode = SharingMode.Exclusive,
+                    Usage = ImageUsageFlags.TransferSrcBit | ImageUsageFlags.TransferDstBit,
+                    InitialLayout = ImageLayout.Undefined
+                };
+                Check(_vk.CreateImage(_device, &info, null, out _browserBackground), "menu background image");
+                _vk.GetImageMemoryRequirements(_device, _browserBackground, out var requirements);
+                var allocation = new MemoryAllocateInfo
+                {
+                    SType = StructureType.MemoryAllocateInfo, AllocationSize = requirements.Size,
+                    MemoryTypeIndex = FindMemoryType(requirements.MemoryTypeBits, MemoryPropertyFlags.DeviceLocalBit)
+                };
+                Check(_deviceInfo.AllocateMemory(allocation, out _browserBackgroundMemory), "menu background memory");
+                Check(_vk.BindImageMemory(_device, _browserBackground, _browserBackgroundMemory, 0), "menu background binding");
+            }
+            var target = PresentationTargetImage(index);
+            var targetOld = restore && !_imageInitialized[index] ? ImageLayout.Undefined : PresentationTargetFinalLayout;
+            var backgroundLayout = _browserBackgroundValid ? ImageLayout.TransferSrcOptimal : ImageLayout.Undefined;
+            var range = ColorSubresourceRange();
+            ImageMemoryBarrier2 Barrier(Image image, ImageLayout from, ImageLayout to) => new()
+            {
+                SType = StructureType.ImageMemoryBarrier2, Image = image, OldLayout = from, NewLayout = to,
+                SrcAccessMask = from == ImageLayout.Undefined ? 0 : AccessFlags2.MemoryReadBit | AccessFlags2.MemoryWriteBit,
+                DstAccessMask = AccessFlags2.MemoryReadBit | AccessFlags2.MemoryWriteBit,
+                SrcQueueFamilyIndex = Vk.QueueFamilyIgnored, DstQueueFamilyIndex = Vk.QueueFamilyIgnored,
+                SubresourceRange = range
+            };
+            void Transition(ImageMemoryBarrier2 barrier) => VulkanSynchronization.PipelineBarrier(_vk, _commandBuffer,
+                PipelineStageFlags.AllCommandsBit, PipelineStageFlags.AllCommandsBit, 0, 0, null, 0, null, 1, &barrier);
+            Transition(Barrier(target, targetOld, restore ? ImageLayout.TransferDstOptimal : ImageLayout.TransferSrcOptimal));
+            if (restore && !_browserBackgroundValid)
+            {
+                var black = new ClearColorValue(0f, 0f, 0f, 1f);
+                var clearRange = ColorSubresourceRange();
+                _vk.CmdClearColorImage(_commandBuffer, target, ImageLayout.TransferDstOptimal, &black, 1, &clearRange);
+            }
+            else
+            {
+                Transition(Barrier(_browserBackground, backgroundLayout,
+                    restore ? ImageLayout.TransferSrcOptimal : ImageLayout.TransferDstOptimal));
+                var copy = new ImageCopy
+                {
+                    SrcSubresource = new(ImageAspectFlags.ColorBit, 0, 0, 1),
+                    DstSubresource = new(ImageAspectFlags.ColorBit, 0, 0, 1), Extent = new(_extent.Width, _extent.Height, 1)
+                };
+                _vk.CmdCopyImage(_commandBuffer, restore ? _browserBackground : target, ImageLayout.TransferSrcOptimal,
+                    restore ? target : _browserBackground, ImageLayout.TransferDstOptimal, 1, &copy);
+                if (!restore)
+                {
+                    Transition(Barrier(_browserBackground, ImageLayout.TransferDstOptimal, ImageLayout.TransferSrcOptimal));
+                    _browserBackgroundValid = true;
+                }
+            }
+            Transition(Barrier(target, restore ? ImageLayout.TransferDstOptimal : ImageLayout.TransferSrcOptimal,
+                PresentationTargetFinalLayout));
+        }
+    }
+}
