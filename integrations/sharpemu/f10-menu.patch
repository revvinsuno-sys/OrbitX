+using SDL;
+using SharpEmu.HLE.Host;
+using SharpEmu.Libs.Pad;
+using SharpEmu.Libs.VideoOut;
+using Xunit;
+
+namespace SharpEmu.Libs.Tests.VideoOut;
+
+[CollectionDefinition("Browser menu", DisableParallelization = true)]
+public sealed class BrowserMenuCollection { }
+
+[Collection("Browser menu")]
+public sealed class BrowserGameMenuTests
+{
+    [Fact]
+    public void ToggleResumeExitRepeatAndCancel()
+    {
+        HostWindowInput.Connect();
+        try
+        {
+            BrowserGameMenu.Close();
+            Assert.False(BrowserGameMenu.Key(SDL_Keycode.SDLK_A, true, false, out _));
+            Assert.True(BrowserGameMenu.Key(SDL_Keycode.SDLK_F10, true, false, out _));
+            Assert.True(BrowserGameMenu.Visible);
+            BrowserGameMenu.Key(SDL_Keycode.SDLK_F10, true, true, out _);
+            BrowserGameMenu.Key(SDL_Keycode.SDLK_F10, false, false, out _);
+            Assert.True(BrowserGameMenu.Visible);
+            BrowserGameMenu.Key(SDL_Keycode.SDLK_DOWN, true, false, out _);
+            BrowserGameMenu.Key(SDL_Keycode.SDLK_RETURN, true, true, out var exit);
+            Assert.False(exit);
+            BrowserGameMenu.Key(SDL_Keycode.SDLK_ESCAPE, true, false, out exit);
+            Assert.False(exit);
+            Assert.False(BrowserGameMenu.Visible);
+            BrowserGameMenu.Key(SDL_Keycode.SDLK_F10, true, false, out _);
+            Assert.False(BrowserGameMenu.ExitSelected);
+            BrowserGameMenu.Key(SDL_Keycode.SDLK_RETURN, true, false, out exit);
+            Assert.False(exit);
+            Assert.False(BrowserGameMenu.Visible);
+            BrowserGameMenu.Key(SDL_Keycode.SDLK_F10, true, false, out _);
+            BrowserGameMenu.Key(SDL_Keycode.SDLK_DOWN, true, false, out _);
+            BrowserGameMenu.Key(SDL_Keycode.SDLK_RETURN, true, false, out exit);
+            Assert.True(exit);
+            Assert.False(BrowserGameMenu.Visible);
+        }
+        finally { BrowserGameMenu.Close(); HostWindowInput.Disconnect(); }
+    }
+
+    [Fact]
+    public void CapturesKeyboardAndControllerUntilReleasedAndDrawsWithoutStats()
+    {
+        HostWindowInput.Connect();
+        try
+        {
+            BrowserGameMenu.Close();
+            var source = HostWindowInputSource.Current!;
+            HostWindowInput.SetKey(0x57, true);
+            BrowserGameMenu.Key(SDL_Keycode.SDLK_F10, true, false, out _);
+            Assert.True(PerfOverlay.DrawOnScreen);
+            HostWindowInput.SetKey(0x0D, true);
+            Assert.False(source.IsKeyDown(0x57));
+            Assert.False(source.IsKeyDown(0x0D));
+            var pad = new HostGamepadState(true, HostGamepadButtons.Cross, 128, 128, 128, 128, 0, 0);
+            HostWindowInput.SetGamepad("test", pad);
+            Span<HostGamepadState> snapshots = stackalloc HostGamepadState[1];
+            Assert.Equal(1, source.GetGamepadStates(snapshots));
+            Assert.Equal(HostGamepadButtons.None, snapshots[0].Buttons);
+            var pixels = new byte[PerfOverlay.PixelBufferWidth * PerfOverlay.PixelBufferHeight * 4];
+            PerfOverlay.Fill(pixels, 0, 0);
+            Assert.Contains((byte)0x60, pixels);
+            static bool HasWhiteGlyph(byte[] image, int firstY, int lastY)
+            {
+                for (var y = firstY; y < lastY; y++)
+                for (var x = 0; x < PerfOverlay.PixelBufferWidth; x++)
+                {
+                    var offset = (y * PerfOverlay.PixelBufferWidth + x) * 4;
+                    if (image[offset] == 0xFF && image[offset + 1] == 0xFF && image[offset + 2] == 0xFF) return true;
+                }
+                return false;
+            }
+            Assert.True(HasWhiteGlyph(pixels, 48, 64), "Continue is visible in the menu.");
+            Assert.True(HasWhiteGlyph(pixels, 82, 98), "Exit is visible in the menu.");
+            BrowserGameMenu.Close();
+            Assert.False(source.IsKeyDown(0x0D));
+            Assert.False(source.IsKeyDown(0x57));
+            HostWindowInput.SetGamepad("test", pad);
+            source.GetGamepadStates(snapshots);
+            Assert.Equal(HostGamepadButtons.None, snapshots[0].Buttons);
+            HostWindowInput.SetGamepad("test", pad with { Buttons = HostGamepadButtons.None });
+            HostWindowInput.SetGamepad("test", pad);
+            source.GetGamepadStates(snapshots);
+            Assert.Equal(HostGamepadButtons.Cross, snapshots[0].Buttons);
+            HostWindowInput.SetKey(0x57, false);
+            HostWindowInput.SetKey(0x57, true);
+            Assert.True(source.IsKeyDown(0x57));
+        }
+        finally { BrowserGameMenu.Close(); HostWindowInput.Disconnect(); }
